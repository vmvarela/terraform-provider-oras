root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,json,tf}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Trailing double-space = hard line break in Markdown; don't trim.
trim_trailing_whitespace = false
